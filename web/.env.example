# --- App ---
NEXT_PUBLIC_SITE_URL=https://www.tanger-animalerie.ma
NEXT_PUBLIC_WHATSAPP_NUMBER=212644498909
NEXT_PUBLIC_PHONE_NUMBER=+212644498909

# --- Auth (NextAuth v5) ---
AUTH_SECRET=replace-with-openssl-rand-base64-32
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# --- Database (choose one and wire lib/data/* to it) ---
# DATABASE_URL=postgresql://user:password@localhost:5432/tanger_animalerie
# Recommended: Postgres via Prisma or Drizzle, or a managed Postgres (Neon/Supabase)

# --- Rate limiting (recommended: Upstash Redis in production) ---
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Media storage (for Media Library / image uploads) ---
# CLOUDINARY_URL=

# --- Analytics & tracking (all optional — each only loads if its ID is set,
#     and only after the visitor accepts the cookie consent banner) ---
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
# NEXT_PUBLIC_META_PIXEL_ID=
# NEXT_PUBLIC_TIKTOK_PIXEL_ID=
# NEXT_PUBLIC_CLARITY_ID=
